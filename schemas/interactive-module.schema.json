{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional Mint relationship interaction, not a layout",
  "type": "object",
  "required": ["id", "type", "goal", "nodes", "edges"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "type": { "enum": ["workflow", "sequence", "dataflow", "lifecycle", "architecture"] },
    "goal": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "maxItems": 200, "minItems": 1, "items": { "type": "object", "required": ["id", "fieldPath", "sourceUnitRefs"], "properties": { "id": { "type": "string" }, "fieldPath": { "type": "string" }, "sourceUnitRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } },
    "edges": { "type": "array", "maxItems": 500, "items": { "type": "object", "required": ["id", "from", "to", "relation", "directed", "sourceUnitRefs"], "properties": { "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "relation": { "enum": ["sequence", "branch", "dependency", "temporal", "message", "dataflow", "transition", "contains", "association"] }, "directed": { "type": "boolean" }, "sourceUnitRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } },
    "guidedViews": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["nodeIds"], "properties": { "nodeIds": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } }
  }
}

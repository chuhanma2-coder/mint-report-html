{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mint Collaborative Report Brief",
  "type": "object",
  "required": ["schemaVersion", "kind", "skillContractVersion", "reportId", "title", "sections", "designContract", "artDirection", "publish"],
  "properties": {
    "schemaVersion": { "const": "0.12.0" },
    "kind": { "const": "mint-task-card" },
    "skillContractVersion": { "const": "mint-report-html/0.12" },
    "reportId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "sectionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "owner": { "type": "string" },
          "outlineItems": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "outlineOrder": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "designContract": {
      "type": "object",
      "required": ["tokenVersion", "artDirectionSeed", "stage", "aspectRatio", "pageChrome"],
      "properties": {
        "tokenVersion": { "const": "mint-scheme-c-original/1" },
        "artDirectionSeed": { "type": "string" },
        "stage": { "const": "1920x1080" },
        "aspectRatio": { "const": "16:9" },
        "pageChrome": { "const": "none" }
      }
    },
    "artDirection": {
      "type": "object",
      "required": ["palette", "visualMood", "motionLanguage"],
      "properties": {
        "palette": { "const": "mint-scheme-c-original" },
        "visualMood": { "type": "string" },
        "motionLanguage": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
      }
    },
    "publish": {
      "type": "object",
      "required": ["aspectRatio", "headers", "footers", "pageNumbers", "formats"],
      "properties": {
        "aspectRatio": { "const": "16:9" },
        "headers": { "const": false },
        "footers": { "const": false },
        "pageNumbers": { "const": false },
        "formats": { "type": "array", "items": { "enum": ["html", "pptx", "pdf"] }, "minItems": 1 }
      }
    }
  }
}
